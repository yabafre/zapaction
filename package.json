{
  "name": "zapaction",
  "version": "0.3.0",
  "private": true,
  "description": "ZapAction monorepo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yabafre/zapaction.git"
  },
  "bugs": {
    "url": "https://github.com/yabafre/zapaction/issues"
  },
  "homepage": "https://github.com/yabafre/zapaction#readme",
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "dev": "turbo run dev --filter=@zapaction/docs",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "release:prepare-packages": "node scripts/rewrite-workspace-deps.mjs",
    "release:dry-run": "node scripts/rewrite-workspace-deps.mjs --dry-run"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.108.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turbo": "^2.11.13",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
